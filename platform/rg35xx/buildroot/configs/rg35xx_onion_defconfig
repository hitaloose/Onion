# Target: Actions ATM7039S (Cortex-A9, NEON), stock kernel 3.10.37
BR2_arm=y
BR2_cortex_a9=y
BR2_ARM_ENABLE_NEON=y
BR2_ARM_ENABLE_VFP=y
BR2_ARM_FPU_NEON=y
BR2_ARM_EABIHF=y

# Toolchain: glibc, headers matching the stock kernel (it cannot be replaced)
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_KERNEL_HEADERS_3_10=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_TOOLCHAIN_BUILDROOT_WCHAR=y
BR2_PACKAGE_HOST_GDB=y

# System: no init of its own, it runs chrooted under the stock Android-style init
BR2_INIT_NONE=y
BR2_ROOTFS_DEVICE_CREATION_STATIC=y
BR2_SYSTEM_BIN_SH_BUSYBOX=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_ONION_RG35XX_PATH)/board/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_ONION_RG35XX_PATH)/board/post-build.sh"

# Graphics: SDL 1.2 on fbcon (Onion UIs), SDL2 for future standalone emulators
BR2_PACKAGE_SDL=y
BR2_PACKAGE_SDL_FBCON=y
BR2_PACKAGE_SDL_IMAGE=y
BR2_PACKAGE_SDL_IMAGE_PNG=y
BR2_PACKAGE_SDL_IMAGE_JPEG=y
BR2_PACKAGE_SDL_TTF=y
BR2_PACKAGE_SDL_MIXER=y
BR2_PACKAGE_SDL_GFX=y
BR2_PACKAGE_SDL2=y
BR2_PACKAGE_LIBPNG=y
BR2_PACKAGE_JPEG=y
BR2_PACKAGE_FREETYPE=y

# Audio
BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y

# Libraries and tools used by Onion scripts
BR2_PACKAGE_ZLIB=y
BR2_PACKAGE_SQLITE=y
BR2_PACKAGE_JQ=y
BR2_PACKAGE_7ZIP=y
BR2_PACKAGE_EVTEST=y
BR2_PACKAGE_FBSET=y
BR2_PACKAGE_GDB=y

# Output: ext4 image loop-mounted by misc/dmenu.bin
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="256M"
BR2_TARGET_ROOTFS_EXT2_LABEL="onion"
# BR2_TARGET_ROOTFS_TAR is not set
