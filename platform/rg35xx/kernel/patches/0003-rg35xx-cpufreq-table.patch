The S500 table stops at 900 MHz (listed twice). Use the RG35XX table of the
Garlic OS kernel (same board, same cpuvdd regulator): 240 MHz to 1488 MHz.
Onion caps scaling_max_freq at 1200 MHz (1488 hung the device while charging).

--- a/drivers/cpufreq/s500-cpufreq.c
+++ b/drivers/cpufreq/s500-cpufreq.c
@@ -50,12 +50,15 @@
 static struct cpu0_opp_table cpu0_table[] = {
 	/*khz		uV*/
-
-//	{1104000, 1175000},
-	{ 900000, 1025000},
-	{ 900000, 1025000},
-	{ 720000,  975000},
-	{ 504000,  950000},
-	{ 240000,  950000},
+	{1488000, 1375000},
+	{1392000, 1325000},
+	{1296000, 1275000},
+	{1200000, 1200000},
+	{1104000, 1175000},
+	{1008000, 1100000},
+	{ 840000, 1075000},
+	{ 720000, 1025000},
+	{ 504000, 1000000},
+	{ 240000,  975000},
 };
 
 struct device cpu0_dev;
