#!/bin/sh
cd /mnt/SDCARD/.tmp_update
./runtime.sh

# Turn off if runtime exits
echo "Runtime exited unexpectedly"
if [ "$(cat /tmp/deviceModel)" = "35" ]; then
    # RG35XX: the stock init ignores the reboot signal, so reboot directly,
    # after leaving the card clean
    sync
    mount -o remount,ro /mnt/SDCARD
    reboot -f
else
    reboot
fi
sleep 10
