--- a/gfx/drivers_context/mali_fbdev_ctx.c	2026-10-30 17:03:54
+++ b/gfx/drivers_context/mali_fbdev_ctx.c	2026-10-30 17:04:11
@@ -71,6 +71,43 @@
 static mali_ctx_data_t *gfx_ctx_mali_fbdev_global = NULL;
 static uint8_t mali_flags = 0;
 
+#ifdef RG35XX
+/* owlfb (RG35XX): the PowerVR FLIP window system ignores eglSwapInterval,
+ * so vsync waits for the display interrupt after each swap. The owlfb
+ * OWLFB_WAITFORVSYNC returns at once unless the interrupt is enabled with
+ * OWLFB_VSYNC_EVENT_EN (the Android hwcomposer did that on the stock
+ * firmware) */
+struct owlfb_sync_info
+{
+   uint8_t enabled;
+   uint8_t disp_id;
+   uint16_t reserved2;
+};
+
+#define OWLFB_WAITFORVSYNC   _IOW('O', 57, long long)
+#define OWLFB_VSYNC_EVENT_EN _IOW('O', 67, struct owlfb_sync_info)
+
+static int owlfb_vsync_fd       = -1;
+static int owlfb_swap_interval  = 0;
+
+static void owlfb_vsync_enable(bool enable)
+{
+   struct owlfb_sync_info sync = { enable, 0, 0 };
+
+   if (enable && owlfb_vsync_fd < 0)
+      owlfb_vsync_fd = open("/dev/fb0", O_RDWR);
+   if (owlfb_vsync_fd < 0)
+      return;
+   if (ioctl(owlfb_vsync_fd, OWLFB_VSYNC_EVENT_EN, &sync) < 0)
+      RARCH_ERR("[Mali] OWLFB_VSYNC_EVENT_EN failed.\n");
+   if (!enable)
+   {
+      close(owlfb_vsync_fd);
+      owlfb_vsync_fd = -1;
+   }
+}
+#endif
+
