# Changes to rg35xx_atm7039_defconfig for Onion, merged by build.sh

# Gamepad (platform/rg35xx/kernel/drivers/rg35xx-gamepad.c); joydev gives
# the js0 node the Garlic kernel also has
CONFIG_JOYSTICK_RG35XX=y
CONFIG_INPUT_JOYDEV=y

# ADB and USB mass storage: the ramdisk's usbmond.sh drives
# /sys/class/android_usb
CONFIG_USB_G_ANDROID=y

# /proc/config.gz, to check what a running kernel was built with
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# The USB monitor must follow the ramdisk's usbmond.sh (Android flow:
# usb_con_msg, run); the Linux flow ignores it and ADB never connects
# CONFIG_USB_PLATFORM_LINUX is not set
