+#ifdef RG35XX
+   {
+      /* An overlay opened over the paused game (GameSwitcher, the saving
+       * message) may have changed the framebuffer mode: set ours again */
+      static int fb_fd = -1;
+      struct fb_var_screeninfo vinfo;
+
+      if (fb_fd < 0)
+         fb_fd = open("/dev/fb0", O_RDONLY);
